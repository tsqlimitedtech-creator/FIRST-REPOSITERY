<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIJA Travels & Tours Ltd. | Hajj & Umrah Specialist</title>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* LUXURIOUS ISLAMIC BRAND DESIGN SYSTEM: BLACK, GOLD, SKY BLUE & PURE WHITE */
    :root {
      --primary-black: #0B0F17;       /* Rich Deep Luxury Black */
      --secondary-black: #161D2A;     /* Soft Charcoal Dark Card */
      --sky-blue: #0284C7;          /* Primary Bright Sky Blue */
      --dark-sky-blue: #0369A1;     /* Deep Sky Blue */
      --sky-gradient: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
      --light-sky-blue: #F0F9FF;    /* Ultra Soft Sky Tint */
      --primary-gold: #D4AF37;      /* Rich Metallic Gold */
      --gold-hover: #B8952B;        /* Darker Gold Accent */
      --gold-gradient: linear-gradient(135deg, #D4AF37 0%, #F3E5AB 50%, #B8952B 100%);
      --bg-light: #F8FAFC;          /* Clean Crisp Off-White */
      --text-dark: #0F172A;         /* Slate Charcoal Text */
      --text-muted: #64748B;        /* Muted Text Color */
      --white: #FFFFFF;             /* Pure White */
      --gray-border: #E2E8F0;
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 20px;
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 10px 25px rgba(2, 132, 199, 0.12);
      --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Poppins', sans-serif;
      color: var(--text-dark);
      background-color: var(--bg-light);
      line-height: 1.6;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .brand-title {
      font-family: 'Playfair Display', serif;
    }

    .container {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* TOP UTILITY BAR */
    .top-bar {
      background: var(--primary-black);
      color: var(--white);
      font-size: 0.8rem;
      padding: 10px 0;
      border-bottom: 2px solid var(--primary-gold);
    }

    .top-bar-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .contact-info {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .contact-info span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .badge-accredited {
      color: var(--primary-gold);
      font-weight: 600;
      background: rgba(212, 175, 55, 0.15);
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(212, 175, 55, 0.4);
    }

    .admin-link-btn {
      background: var(--gold-gradient);
      color: var(--primary-black);
      padding: 5px 14px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-block;
    }

    .admin-link-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4);
    }

    /* NAVBAR & RESPONSIVE HEADER */
    .navbar {
      background-color: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      padding: 14px 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: var(--shadow-sm);
      border-bottom: 1px solid var(--gray-border);
      transition: all 0.3s ease;
    }

    .nav-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .logo-emblem {
      font-size: 2.2rem;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
    }

    .brand-title {
      color: var(--primary-black);
      font-size: 1.8rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.5px;
    }

    .brand-sub {
      display: block;
      color: var(--sky-blue);
      font-size: 0.65rem;
      letter-spacing: 1.5px;
      font-weight: 600;
    }

    .brand-tag {
      display: block;
      color: var(--primary-gold);
      font-size: 0.55rem;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-links a {
      color: var(--text-dark);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      position: relative;
      padding: 4px 0;
      transition: color 0.3s ease;
    }

    .nav-links a:not(.btn-gold-nav)::after {
      content: '';
      position: absolute;
      width: 0;
      height: 2px;
      bottom: 0;
      left: 0;
      background-color: var(--primary-gold);
      transition: width 0.3s ease;
    }

    .nav-links a:not(.btn-gold-nav):hover::after {
      width: 100%;
    }

    .nav-links a:hover {
      color: var(--sky-blue);
    }

    .btn-gold-nav {
      background: var(--sky-gradient);
      color: var(--white) !important;
      padding: 10px 22px;
      border-radius: 30px;
      font-weight: 600 !important;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
      border: 1px solid var(--primary-gold);
      transition: all 0.3s ease !important;
    }

    .btn-gold-nav:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
      background: var(--dark-sky-blue);
    }

    .mobile-nav-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 1.8rem;
      color: var(--sky-blue);
      cursor: pointer;
      padding: 5px;
    }

    /* HERO SECTION WITH POPPING IMAGE SLIDER EFFECT */
    .hero-section {
      position: relative;
      color: var(--white);
      padding: 100px 0 120px;
      overflow: hidden;
      background-color: var(--primary-black);
    }

    /* BACKGROUND SLIDER KEYFRAMES WITH POPPING FADE */
    .hero-bg-slider {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .slide-item {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transform: scale(1.08);
      animation: popOnOffSlide 16s infinite ease-in-out;
    }

    .slide-item:nth-child(1) {
      background-image: linear-gradient(rgba(11, 15, 23, 0.75), rgba(3, 105, 161, 0.75)), url('The_Ka\'ba,_Great_Mosque_of_Mecca,_Saudi_Arabia_(4).jpg');
      animation-delay: 0s;
    }

    .slide-item:nth-child(2) {
      background-image: linear-gradient(rgba(11, 15, 23, 0.75), rgba(3, 105, 161, 0.75)), url('site-Prophets-Mosque-Medina-Saudi-Arabia-Mecca.webp');
      animation-delay: 4s;
    }

    .slide-item:nth-child(3) {
      background-image: linear-gradient(rgba(11, 15, 23, 0.75), rgba(3, 105, 161, 0.75)), url('images.jfif');
      animation-delay: 8s;
    }

    .slide-item:nth-child(4) {
      background-image: linear-gradient(rgba(11, 15, 23, 0.75), rgba(3, 105, 161, 0.75)), url('images (1).jfif');
      animation-delay: 12s;
    }

    @keyframes popOnOffSlide {
      0% { opacity: 0; transform: scale(1.08); }
      5% { opacity: 1; transform: scale(1); }
      22% { opacity: 1; transform: scale(1.03); }
      27% { opacity: 0; transform: scale(1.08); }
      100% { opacity: 0; }
    }

    /* POPPING WATERMARK LAYER */
    .hero-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 500px;
      height: 500px;
      background: url('The_Ka\'ba,_Great_Mosque_of_Mecca,_Saudi_Arabia_(4).jpg') center/contain no-repeat;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      filter: sepia(100%) hue-rotate(180deg) saturate(300%) brightness(1.2);
      animation: watermarkPop 6s infinite ease-in-out;
    }

    @keyframes watermarkPop {
      0%, 100% {
        opacity: 0.05;
        transform: translate(-50%, -50%) scale(0.85);
      }
      50% {
        opacity: 0.22;
        transform: translate(-50%, -50%) scale(1.08);
      }
    }

    .hero-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 50px;
      align-items: center;
    }

    .bismillah-tag {
      color: var(--primary-gold);
      font-size: 1.1rem;
      letter-spacing: 1px;
      font-weight: 600;
      display: inline-block;
      margin-bottom: 10px;
    }

    .hero-text h1 {
      font-size: 3.3rem;
      line-height: 1.15;
      margin-bottom: 20px;
      font-weight: 700;
    }

    .text-gold {
      color: var(--primary-gold);
      text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .hero-text p {
      font-size: 1.05rem;
      color: var(--light-sky-blue);
      margin-bottom: 30px;
      max-width: 90%;
    }

    .hero-actions {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn-sky {
      background: var(--sky-gradient);
      border: 1px solid var(--primary-gold);
      color: var(--white);
      padding: 14px 28px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      transition: all 0.3s ease;
    }

    .btn-sky:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
    }

    .btn-outline {
      border: 2px solid var(--primary-gold);
      color: var(--white);
      padding: 12px 24px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: 500;
      backdrop-filter: blur(5px);
      transition: all 0.3s ease;
    }

    .btn-outline:hover {
      background: var(--primary-gold);
      color: var(--primary-black);
    }

    /* HERO ENQUIRY CARD */
    .hero-enquiry-card {
      background: rgba(11, 15, 23, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid var(--primary-gold);
      padding: 30px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      color: var(--white);
    }

    .hero-enquiry-card h3 {
      color: var(--primary-gold);
      font-size: 1.5rem;
      margin-bottom: 20px;
      text-align: center;
    }

    .hero-enquiry-card input, .hero-enquiry-card select {
      width: 100%;
      padding: 12px 15px;
      margin-bottom: 15px;
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: var(--radius-sm);
      background-color: rgba(22, 29, 42, 0.9);
      color: var(--white);
      font-family: inherit;
      font-size: 0.9rem;
      transition: border-color 0.3s ease;
    }

    .hero-enquiry-card input:focus, .hero-enquiry-card select:focus {
      outline: none;
      border-color: var(--sky-blue);
    }

    .btn-gold-full {
      width: 100%;
      background: var(--gold-gradient);
      color: var(--primary-black);
      border: none;
      padding: 14px;
      font-weight: 700;
      font-size: 1rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 10px rgba(212, 175, 55, 0.3);
    }

    .btn-gold-full:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(212, 175, 55, 0.5);
    }

    /* TRUST RIBBON */
    .trust-ribbon {
      background: var(--white);
      border-bottom: 1px solid var(--gray-border);
      padding: 30px 0;
      box-shadow: var(--shadow-sm);
    }

    .trust-flex {
      display: flex;
      justify-content: space-around;
      text-align: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .trust-item {
      padding: 10px 15px;
      border-radius: var(--radius-sm);
      transition: transform 0.3s ease;
    }

    .trust-item:hover {
      transform: translateY(-3px);
    }

    .trust-item span {
      font-size: 2rem;
      display: block;
      margin-bottom: 5px;
    }

    /* SECTIONS */
    .section-padding {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-header h2 {
      font-size: 2.3rem;
      color: var(--primary-black);
      margin-bottom: 10px;
    }

    .section-header p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    .gold-divider {
      color: var(--primary-gold);
      font-size: 1.2rem;
      margin-top: 5px;
    }

    /* COMPANY HISTORY & CEO SECTION */
    .about-section {
      background: var(--white);
      border-bottom: 1px solid var(--gray-border);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: stretch;
    }

    .about-box {
      background: var(--light-sky-blue);
      border-left: 5px solid var(--sky-blue);
      padding: 35px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }

    .about-box h3 {
      color: var(--dark-sky-blue);
      margin-bottom: 15px;
      font-size: 1.6rem;
    }

    .ceo-card {
      background: var(--secondary-black);
      color: var(--white);
      border: 1px solid var(--primary-gold);
      padding: 35px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
    }

    .ceo-card h3 {
      color: var(--primary-gold);
      margin-bottom: 5px;
    }

    .ceo-title {
      color: var(--sky-blue);
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 15px;
      display: block;
    }

    .ceo-card p {
      color: var(--light-sky-blue);
    }

    /* SACRED DESTINATIONS SHOWCASE WITH UPLOADED IMAGES */
    .showcase-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }

    .showcase-card {
      background: var(--white);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--gray-border);
      transition: all 0.3s ease;
      position: relative;
    }

    .showcase-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-md);
      border-color: var(--primary-gold);
    }

    .showcase-img-container {
      position: relative;
      height: 230px;
      overflow: hidden;
    }

    .showcase-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .showcase-card:hover .showcase-img {
      transform: scale(1.08);
    }

    .showcase-body {
      padding: 22px;
    }

    .showcase-body h3 {
      color: var(--primary-black);
      font-size: 1.25rem;
      margin-bottom: 8px;
    }

    .showcase-body p {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* SERVICES GRID */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
    }

    .service-box {
      background: var(--white);
      padding: 30px 25px;
      border-radius: var(--radius-md);
      border-top: 4px solid var(--sky-blue);
      box-shadow: var(--shadow-sm);
      border-left: 1px solid var(--gray-border);
      border-right: 1px solid var(--gray-border);
      border-bottom: 1px solid var(--gray-border);
      transition: all 0.3s ease;
    }

    .service-box:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
      border-top-color: var(--primary-gold);
    }

    .service-box h4 {
      color: var(--primary-black);
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .service-box p {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    /* PACKAGES GRID */
    .packages-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
    }

    .package-card {
      background: var(--white);
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--gray-border);
      box-shadow: var(--shadow-sm);
      position: relative;
      transition: all 0.3s ease;
    }

    .package-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
    }

    .package-card.featured {
      border: 2px solid var(--primary-gold);
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
    }

    .pkg-badge {
      position: absolute;
      top: 15px;
      left: 15px;
      color: var(--white);
      padding: 5px 14px;
      font-size: 0.75rem;
      font-weight: 700;
      border-radius: 20px;
      z-index: 10;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    .pkg-badge.economy { background: var(--sky-blue); }
    .pkg-badge.standard { background: var(--dark-sky-blue); }
    .pkg-badge.vip { background: var(--gold-gradient); color: var(--primary-black); }

    .pkg-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .pkg-body {
      padding: 25px;
    }

    .price-label {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .price-amount {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--sky-blue);
      display: block;
      margin-bottom: 15px;
    }

    .pkg-features {
      list-style: none;
      margin-bottom: 25px;
      font-size: 0.9rem;
    }

    .pkg-features li {
      margin-bottom: 10px;
      color: var(--text-dark);
    }

    .btn-card {
      width: 100%;
      padding: 12px;
      border: 2px solid var(--sky-blue);
      background: transparent;
      color: var(--sky-blue);
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-card.active, .btn-card:hover {
      background: var(--sky-gradient);
      border-color: transparent;
      color: var(--white);
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2);
    }

    /* STATS BANNER */
    .stats-banner {
      background: var(--primary-black);
      border-top: 2px solid var(--primary-gold);
      border-bottom: 2px solid var(--primary-gold);
      color: var(--white);
      padding: 65px 0;
      text-align: center;
      position: relative;
    }

    .stats-flex {
      display: flex;
      justify-content: space-around;
      margin-bottom: 25px;
      flex-wrap: wrap;
      gap: 25px;
    }

    .stat-box h2 {
      font-size: 2.8rem;
      color: var(--primary-gold);
      font-weight: 700;
    }

    .stat-box p {
      font-size: 0.95rem;
      color: var(--light-sky-blue);
    }

    .stats-subtext {
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid var(--primary-gold);
      color: var(--primary-gold);
      padding: 12px 25px;
      font-weight: 600;
      font-size: 0.95rem;
      display: inline-block;
      border-radius: 30px;
      backdrop-filter: blur(5px);
    }

    /* PAYMENT & BANK ACCOUNTS */
    .payment-banner {
      background: var(--white);
      padding: 80px 0;
      border-top: 1px solid var(--gray-border);
    }

    .bank-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
      margin-top: 30px;
    }

    .bank-card {
      background: var(--light-sky-blue);
      border: 1px solid #BAE6FD;
      padding: 25px;
      border-radius: var(--radius-md);
      text-align: left;
      transition: all 0.3s ease;
    }

    .bank-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-sm);
      border-color: var(--primary-gold);
    }

    .bank-card h4 {
      color: var(--dark-sky-blue);
      margin-bottom: 12px;
      font-size: 1.1rem;
    }

    .bank-card p {
      font-size: 0.9rem;
      color: var(--text-dark);
      margin-bottom: 4px;
    }

    .payment-methods-row {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
      margin-bottom: 30px;
    }

    .pay-method {
      background: var(--bg-light);
      border: 1px solid var(--primary-gold);
      padding: 10px 20px;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--primary-black);
    }

    /* ACCREDITATIONS GRID */
    .cert-grid {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .cert-card {
      background: var(--white);
      border: 1px solid var(--gray-border);
      padding: 20px 30px;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      box-shadow: var(--shadow-sm);
      text-align: center;
    }

    /* ADMIN DASHBOARD MODAL */
    .admin-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(11, 15, 23, 0.85);
      backdrop-filter: blur(5px);
      z-index: 3000;
      overflow-y: auto;
      padding: 40px 15px;
    }

    .admin-content {
      background: var(--white);
      max-width: 950px;
      margin: 0 auto;
      border-radius: var(--radius-md);
      padding: 35px;
      border: 2px solid var(--primary-gold);
